---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Browser from '../../components/Browser.astro';
import Phone from '../../components/Phone.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import { url, demoHref } from '../../config';
import { features, type Feature } from '../../data/features';
import { screen } from '../../data/screens';

export function getStaticPaths() {
  return features.map((f) => ({ params: { slug: f.slug }, props: { f } }));
}
interface Props { f: Feature }
const { f } = Astro.props;
const others = features.filter((o) => o.slug !== f.slug);
const abs = (p: string) => new URL(url(p), Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Početna', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Funkcionalnosti', item: abs('/funkcionalnosti/') },
      { '@type': 'ListItem', position: 3, name: f.name, item: abs(`/funkcionalnosti/${f.slug}/`) }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: f.faq.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } }))
  }
];
---
<Base title={f.seoTitle} description={f.seoDescription} jsonLd={jsonLd}>
  <PageHero bleed eyebrow={f.name} title={f.title} accent={f.titleAccent} lead={f.lead} crumbs={[{ href: url('/funkcionalnosti/'), label: 'Funkcionalnosti' }, { href: url(`/funkcionalnosti/${f.slug}/`), label: f.name }]}>
    <div slot="actions" class="actions">
      <a href={demoHref} class="btn btn-primary">Zakaži demo <Icon name="arrow" /></a>
      <a href="#kako" class="btn btn-ghost-dark">Kako radi</a>
    </div>
    <div class="container stage reveal" style="--d:.2s">
      <Browser src={screen(f.screen)} alt={`${f.name} u aplikaciji PSP`} eager />
      {f.mobile && <div class="stage-phone"><Phone src={screen(f.mobile)} alt={`${f.name} na telefonu`} eager /></div>}
    </div>
  </PageHero>

  <section class="section benefits-sec">
    <div class="container">
      <div class="section-head center reveal">
        <span class="eyebrow">Mogućnosti</span>
        <h2 class="h-1">Šta dobijate</h2>
      </div>
      <div class="benefits">
        {f.benefits.map((b, i) => (
          <div class="benefit reveal" style={`--d:${(i % 3) * 0.08}s`}>
            <span class="ico"><Icon name={b.icon} /></span>
            <h3 class="h-3">{b.title}</h3>
            <p>{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section how on-dark" id="kako">
    <div class="glow" aria-hidden="true"></div>
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Kako radi</span>
        <h2 class="h-1">{f.steps.length} koraka, <span class="serif grad">bez komplikacija.</span></h2>
      </div>
      <ol class="steps" style={`--n:${f.steps.length}`}>
        {f.steps.map((s, i) => (
          <li class="step reveal" style={`--d:${i * 0.08}s`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h-3">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section faq-sec">
    <div class="container faq-grid">
      <div class="section-head reveal">
        <span class="eyebrow">Pitanja</span>
        <h2 class="h-2">Česta pitanja o temi <span class="serif grad-dark">{f.name.toLowerCase()}</span></h2>
      </div>
      <div class="reveal" style="--d:.1s"><Faq items={f.faq} /></div>
    </div>
  </section>

  <section class="others-sec">
    <div class="container">
      <h2 class="h-3 others-title">Ostale funkcionalnosti</h2>
      <div class="others">
        {others.map((o) => (
          <a href={url(`/funkcionalnosti/${o.slug}/`)} class="other">
            <span class="ico sm"><Icon name={o.icon} size={20} /></span>
            <span><strong>{o.name}</strong><small>{o.short}</small></span>
            <Icon name="arrow" size={18} class="go" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Base>
<style>
  .actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .stage { position: relative; margin-top: clamp(48px, 7vw, 80px); max-width: 1120px; }
  .stage::before { content: ''; position: absolute; inset: 10% 5% 0; background: radial-gradient(closest-side, rgba(134, 227, 199, .3), transparent); filter: blur(40px); z-index: -1; }
  .stage-phone { position: absolute; right: -2%; bottom: -8%; width: clamp(120px, 18%, 220px); transform: rotate(4deg); }
  .benefits-sec { padding-top: clamp(72px, 9vw, 120px); }
  .benefits { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .benefit { padding: 30px; border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line); display: grid; gap: 8px; align-content: start; transition: transform .3s, box-shadow .3s; }
  .benefit:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .benefit p { color: var(--muted); font-size: 15.5px; }
  .ico { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; background: var(--mint-soft); color: var(--brand-600); margin-bottom: 8px; }
  .ico.sm { width: 40px; height: 40px; margin: 0; flex: none; }
  .how { background: var(--brand-950); color: var(--on-dark); overflow: hidden; isolation: isolate; }
  .how .glow { position: absolute; inset: auto -10% -40% 30%; height: 80%; background: radial-gradient(closest-side, rgba(57, 164, 140, .3), transparent); filter: blur(40px); z-index: -1; }
  .steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 20px; position: relative; }
  .step { position: relative; padding: 28px; border-radius: 22px; background: rgba(255, 255, 255, .04); border: 1px solid rgba(255, 255, 255, .09); display: grid; gap: 10px; align-content: start; }
  .step p { color: var(--on-dark-2); font-size: 15.5px; }
  .num { font-family: var(--serif); font-style: italic; font-size: 44px; line-height: 1; color: var(--mint); }
  .faq-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .others-sec { padding-bottom: 40px; }
  .others-title { margin-bottom: 20px; }
  .others { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 14px; }
  .other { display: flex; align-items: center; gap: 14px; padding: 18px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); transition: border-color .2s, box-shadow .2s, transform .2s; }
  .other:hover { border-color: var(--line-2); box-shadow: var(--shadow); transform: translateY(-2px); }
  .other strong { display: block; font-weight: 650; }
  .other small { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: var(--muted); font-size: 13.5px; line-height: 1.45; }
  .other :global(.go) { margin-left: auto; flex: none; color: var(--brand-500); }
  @media (max-width: 1023px) {
    .benefits { grid-template-columns: 1fr 1fr; }
    .steps { grid-template-columns: 1fr 1fr; }
    .faq-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 767px) {
    .benefits, .steps { grid-template-columns: 1fr; }
    .others { grid-template-columns: 1fr; }
    .stage-phone { width: 28%; bottom: -10%; }
  }
</style>
