---
import Icon from './Icon.astro';
import { url } from '../config';
interface Props { eyebrow: string; title: string; accent: string; lead: string; crumbs?: { href: string; label: string }[]; bleed?: boolean }
const { eyebrow, title, accent, lead, crumbs = [], bleed = false } = Astro.props;
---
<section class:list={['page-hero', 'on-dark', { bleed }]}>
  <div class="bg" aria-hidden="true"><div class="glow"></div><div class="lines"></div></div>
  <div class="container inner">
    {crumbs.length > 0 && (
      <nav class="crumbs reveal" aria-label="Putanja">
        <a href={url('/')}>Početna</a>
        {crumbs.map((c) => (<><Icon name="arrow" size={13} /><a href={c.href}>{c.label}</a></>))}
      </nav>
    )}
    <span class="eyebrow reveal">{eyebrow}</span>
    <h1 class="h-display reveal" style="--d:.06s">{title} <span class="serif grad">{accent}</span></h1>
    <p class="lead reveal" style="--d:.12s">{lead}</p>
    <div class="reveal" style="--d:.18s"><slot name="actions" /></div>
  </div>
  <slot />
</section>
<style>
  .page-hero { position: relative; overflow-x: clip; isolation: isolate; z-index: 1; color: var(--on-dark); padding-top: calc(var(--header-h) + clamp(48px, 7vw, 88px)); }
  .bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; background: var(--brand-950); }
  .bleed .bg { bottom: clamp(110px, 16vw, 240px); }
  .glow { position: absolute; width: 70vw; height: 70vw; left: 50%; top: -45vw; transform: translateX(-50%); border-radius: 50%; background: radial-gradient(closest-side, rgba(57, 164, 140, .45), transparent); filter: blur(60px); }
  .lines { position: absolute; inset: 0; background-image: linear-gradient(rgba(255, 255, 255, .045) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .045) 1px, transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(ellipse 70% 60% at 50% 10%, #000 30%, transparent 75%); }
  .inner { display: grid; justify-items: center; text-align: center; gap: 22px; }
  .inner .h-display { font-size: clamp(40px, 6.4vw, 80px); max-width: 980px; }
  .inner .lead { max-width: 720px; }
  .crumbs { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--on-dark-3); flex-wrap: wrap; justify-content: center; }
  .crumbs a { color: var(--on-dark-2); }
  .crumbs a:hover { color: #fff; }
</style>
