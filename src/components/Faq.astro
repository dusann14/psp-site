---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item, i) => (
    <details class="item" open={i === 0}>
      <summary><span>{item.q}</span><i aria-hidden="true"></i></summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>
<style>
  .faq { display: grid; gap: 12px; }
  .item { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 0 24px; transition: border-color .2s, box-shadow .2s; }
  .item[open] { border-color: var(--line-2); box-shadow: var(--shadow); }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 0; font-weight: 640; font-size: 18px; letter-spacing: -.01em; }
  summary::-webkit-details-marker { display: none; }
  summary i { flex: none; position: relative; width: 30px; height: 30px; border-radius: 50%; background: var(--bg-2); transition: transform .3s, background .3s; }
  summary i::before, summary i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; border-radius: 2px; background: var(--brand-600); transform: translate(-50%, -50%); }
  summary i::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform .3s; }
  .item[open] summary i { background: var(--mint-soft); transform: rotate(180deg); }
  .item[open] summary i::after { transform: translate(-50%, -50%) rotate(0deg); }
  p { color: var(--ink-2); padding: 0 50px 24px 0; }
  @media (max-width: 767px) { .item { padding: 0 18px; } summary { font-size: 16px; } p { padding-right: 0; } }
</style>
